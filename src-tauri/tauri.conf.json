{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Presence for Slack",
  "version": "0.1.0",
  "identifier": "com.josephkim.presence-for-slack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Presence for Slack",
        "width": 320,
        "height": 620,
        "minWidth": 280,
        "minHeight": 420,
        "maxWidth": 420,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "center": true,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "Keep a Slack channel's people and presence visible",
    "longDescription": "A compact macOS people panel for one selected Slack channel, with active/away presence and one-click direct messages.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    }
  }
}
