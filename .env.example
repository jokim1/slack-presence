# Optional local-dev overrides. One-click Connect Slack does not need these
# once the shared Slack app and oauth-worker are configured.
# In-app Settings credentials are applied without a restart; .env is not.

PRESENCE_SLACK_CLIENT_ID=
PRESENCE_SLACK_CLIENT_SECRET=

# Local worker: npm --prefix oauth-worker run dev
# PRESENCE_SLACK_OAUTH_EXCHANGE_URL=http://127.0.0.1:8787/oauth/exchange

# Must exactly match the Redirect URL configured in Slack.
PRESENCE_SLACK_REDIRECT_URI=http://127.0.0.1:53641/oauth/callback
