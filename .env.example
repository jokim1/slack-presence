# Local Slack app credentials. Copy this file to .env; .env is gitignored.
PRESENCE_SLACK_CLIENT_ID=1234567890.1234567890
PRESENCE_SLACK_CLIENT_SECRET=replace-with-your-client-secret

# Must exactly match the Redirect URL configured in Slack.
PRESENCE_SLACK_REDIRECT_URI=http://127.0.0.1:53641/oauth/callback
